{
  "name": "postcss-viewport-fallback",
  "version": "1.5.0",
  "description": "PostCSS plugin that adds classic fallbacks for all dynamic/small/large viewport units (dvh, svh, lvh, dvw, dvmin, ...).",
  "author": "Maksim Kravtsov",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:package": "publint && attw --pack .",
    "bench": "npm run build && node scripts/bench.mjs"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "dependencies": {
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^2.1.9",
    "caniuse-api": "^4.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.15",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Surdeddd/postcss-viewport-fallback.git"
  },
  "bugs": {
    "url": "https://github.com/Surdeddd/postcss-viewport-fallback/issues"
  },
  "homepage": "https://github.com/Surdeddd/postcss-viewport-fallback#readme",
  "keywords": [
    "postcss",
    "postcss-plugin",
    "viewport",
    "dvh",
    "dvw",
    "lvh",
    "svh",
    "dvi",
    "dvb",
    "fallback",
    "css",
    "viewport-units"
  ]
}
