{
  "name": "postcss-viewport-fallback",
  "version": "1.6.0",
  "description": "PostCSS plugin that adds classic fallbacks for all dynamic/small/large viewport units (dvh, svh, lvh, dvw, dvmin, ...).",
  "author": "Maksim Kravtsov",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "runtime": [
        "./dist/runtime.d.ts"
      ]
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:package": "publint && attw --pack .",
    "bench": "npm run build && node scripts/bench.mjs"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "dependencies": {
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "caniuse-api": "^4.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "postcss": "^8.5.15",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "semantic-release": "^25.0.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Surdeddd/postcss-viewport-fallback.git"
  },
  "bugs": {
    "url": "https://github.com/Surdeddd/postcss-viewport-fallback/issues"
  },
  "homepage": "https://github.com/Surdeddd/postcss-viewport-fallback#readme",
  "keywords": [
    "postcss",
    "postcss-plugin",
    "viewport",
    "dvh",
    "dvw",
    "svh",
    "svw",
    "lvh",
    "lvw",
    "dvmin",
    "dvmax",
    "dynamic-viewport-units",
    "viewport-units",
    "fallback",
    "polyfill",
    "100vh",
    "mobile-viewport",
    "css",
    "tailwind"
  ]
}
